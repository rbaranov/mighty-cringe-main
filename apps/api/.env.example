# Development without PostgreSQL uses an ephemeral in-memory store.
DATABASE_URL=
PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated, case-insensitive Google account emails promoted to admin on sign-in.
ADMIN_EMAILS=
# Valid range: 1-90 days.
SESSION_TTL_DAYS=30
