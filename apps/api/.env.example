# Development without PostgreSQL uses an ephemeral in-memory store.
DATABASE_URL=
PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Explicit local-only login. It is ignored when NODE_ENV=production.
LOCAL_DEMO_AUTH=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VAPID_PUBLIC_KEY=
# Optional online discovery for unknown exercises. The key stays server-only.
OPENROUTER_API_KEY=
EXERCISE_DISCOVERY_MODEL=
# Comma-separated, case-insensitive Google account emails promoted to admin on sign-in.
ADMIN_EMAILS=
# Valid range: 1-90 days.
SESSION_TTL_DAYS=30
