# Public hostname. Create A and AAAA records before first Caddy start.
DOMAIN=mightycringe.com

# Application runtime
PORT=3000
WEB_ORIGIN=https://mightycringe.com
LOG_LEVEL=info
DATABASE_URL=postgresql://mightycringe:replace-me@postgres:5432/mightycringe

# Database. Generate a URL-safe password with: openssl rand -hex 32
POSTGRES_DB=mightycringe
POSTGRES_USER=mightycringe
POSTGRES_PASSWORD=replace-with-a-long-random-value

# To be added when the integrations are implemented.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENROUTER_API_KEY=
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=hel1
S3_BUCKET=mighty-cringe-production
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Independent encryption password. Generate at least 32 random bytes and keep an offline copy.
RESTIC_PASSWORD=
# Retention: 14 daily, 8 weekly and 12 monthly snapshots.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# Validate repository metadata and a random data subset after every daily backup.
RESTIC_CHECK_SUBSET=5%
