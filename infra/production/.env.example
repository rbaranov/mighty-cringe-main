# Public hostname. Create A and AAAA records before first Caddy start.
DOMAIN=mightycringe.com

# Application runtime
PORT=3000
WEB_ORIGIN=https://mightycringe.com
LOG_LEVEL=info
DATABASE_URL=postgresql://mightycringe:replace-me@postgres:5432/mightycringe

# Database. Generate a URL-safe password with: openssl rand -hex 32
POSTGRES_DB=mightycringe
POSTGRES_USER=mightycringe
POSTGRES_PASSWORD=replace-with-a-long-random-value

# Google OAuth Web client. Authorized redirect URI:
# https://mightycringe.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated, case-insensitive account emails promoted to admin on sign-in.
ADMIN_EMAILS=
# Comma-separated, case-insensitive account emails enabled for the trainer console on sign-in.
TRAINER_EMAILS=
SESSION_TTL_DAYS=30

# Voice is disabled while every OpenRouter and VOICE_S3 value below is empty.
# Configure both complete groups together; partial configuration fails the deployment preflight.
# OpenRouter server key. Keep input/output logging disabled and enforce ZDR for the key.
OPENROUTER_API_KEY=
# Example model after the key is configured: openai/whisper-large-v3
OPENROUTER_STT_MODEL=

# Dedicated private voice bucket in Helsinki. Do not reuse the backup bucket or credentials.
VOICE_S3_ENDPOINT=
VOICE_S3_REGION=
VOICE_S3_BUCKET=
VOICE_S3_ACCESS_KEY_ID=
VOICE_S3_SECRET_ACCESS_KEY=
VOICE_S3_FORCE_PATH_STYLE=false
# Exactly 32 random bytes encoded as base64: openssl rand -base64 32
# Store a recovery copy outside the VPS; losing it makes retained audio unreadable.
VOICE_S3_ENCRYPTION_KEY=
WORKER_INTERVAL_MS=15000

# Encrypted PostgreSQL backups are disabled while all six values below are empty.
# Configure the complete group together; use a dedicated private bucket and credentials.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Independent encryption password. Generate at least 32 random bytes and keep an offline copy.
RESTIC_PASSWORD=
# Retention: 14 daily, 8 weekly and 12 monthly snapshots.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# Validate repository metadata and a random data subset after every daily backup.
RESTIC_CHECK_SUBSET=5%

# Web Push is disabled while all three VAPID values are empty. Configure them together.
# Generate this pair once and keep the private key server-only:
# pnpm --filter @mighty-cringe/push exec web-push generate-vapid-keys --json
# Example after the pair is generated: mailto:owner@mightycringe.com
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
