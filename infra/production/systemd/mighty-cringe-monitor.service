[Unit]
Description=Mighty & Cringe production availability and data-safety checks
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
EnvironmentFile=/etc/mighty-cringe/monitoring-runner.env
ExecStart=/usr/local/lib/mighty-cringe/run-monitoring.sh
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
TimeoutStartSec=2m
